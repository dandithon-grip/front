VITE_API_BASE_URL=https://server-production-f8be.up.railway.app
# Browser public/publishable key only. Never use service_role / sb_secret_.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: SDK domain registration and Kakao Maps activation are required.
VITE_KAKAO_JAVASCRIPT_KEY=
# ODsay URI-platform browser key. Register localhost:3000 and deployment origin in ODsay.
VITE_ODSAY_WEB_KEY=
# In-app map fallback. For high-traffic hosting choose a suitable tile provider.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors
# Must match the server's private Storage bucket.
VITE_SUPABASE_RECORD_BUCKET=records
# Firebase Web App public config (not the server service-account JSON).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
